{
  "name": "feedback-sdk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:sdk && next dev -p 3000",
    "build": "npm run build:sdk && next build",
    "start": "next start -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:sdk": "node scripts/build-sdk.mjs",
    "watch:sdk": "node scripts/build-sdk.mjs --watch",
    "worker": "tsx scripts/analysis-worker.ts",
    "check:analysis": "tsx scripts/compare-analysis.ts",
    "seed:demo": "tsx scripts/seed-demo-recording.ts",
    "demo:host": "npx -y serve ../feedback-sdk-demo-page -l 3001 --no-clipboard",
    "e2e": "playwright test",
    "db:reset": "npx -y supabase@latest db reset"
  },
  "dependencies": {
    "@rrweb/record": "^2.2.2",
    "@supabase/supabase-js": "^2.119.0",
    "fix-webm-duration": "^1.0.6",
    "next": "16.4.6",
    "pretendard": "^1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-check-file": "^3.3.2",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
