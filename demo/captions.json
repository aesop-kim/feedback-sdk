    {
      "id": "speech-02",
      "kind": "speech",
      "text": "새 계약서를 하나 만들려고 눌렀는데, 아무 반응이 없어요.",
      "narrationStart": 14.28,
      "narrationEnd": 18.24
    },
    {
      "id": "speech-03",
      "kind": "speech",
      "text": "혹시 몰라서 한 번 더 눌러 봤는데도 똑같아요.",
      "narrationStart": 18.49,
      "narrationEnd": 21.67
    },
    {
      "id": "speech-header-intro",
      "kind": "speech",
      "text": "그다음은 표 머리글이에요.",
      "narrationStart": 27.36,
      "narrationEnd": 29.08
    },
    {
      "id": "speech-04",
      "kind": "speech",
      "text": "여기 금액 칸 제목이 계약 금액이어야 하는데,",
      "narrationStart": 29.32,
      "narrationEnd": 32.22
    },
    {
      "id": "speech-05",
      "kind": "speech",
      "text": "계약 긍액이라고 오타가 나 있어요.",
      "narrationStart": 32.47,
      "narrationEnd": 34.85
    },
    {
      "id": "speech-06",
      "kind": "speech",
      "text": "마지막으로 맨 위에 있는 전체 계약서라는 제목이요.",
      "narrationStart": 39.21,
      "narrationEnd": 42.5
    },
    {
      "id": "speech-07",
      "kind": "speech",
      "text": "이 글씨가 다른 곳이랑 좀 달라 보여요.",
      "narrationStart": 42.74,
      "narrationEnd": 45.36
    },
    {
      "id": "speech-08",
      "kind": "speech",
      "text": "정확히 뭐가 문제인지는 저도 모르겠는데,",
      "narrationStart": 45.64,
      "narrationEnd": 48.53
